<script>
        // Simple slider-input synchronization
        document.querySelectorAll('input[type="range"]').forEach(slider => {
            const input = slider.closest('.grid').querySelector('input[type="number"]');
            slider.addEventListener('input', (e) => {
                input.value = e.target.value;
            });
            input.addEventListener('input', (e) => {
                slider.value = e.target.value;
            });
        });

        // Template toggle effect
        const templates = document.querySelectorAll('section button');
        templates.forEach(btn => {
            btn.addEventListener('click', () => {
                templates.forEach(b => {
                    b.classList.remove('bg-primary-container', 'border-primary');
                    b.classList.add('bg-surface-container', 'border-outline-variant');
                    b.querySelector('.material-symbols-outlined').classList.remove('text-primary');
                    b.querySelector('.material-symbols-outlined').classList.add('text-on-surface');
                });
                btn.classList.add('bg-primary-container', 'border-primary');
                btn.classList.remove('bg-surface-container', 'border-outline-variant');
                btn.querySelector('.material-symbols-outlined').classList.add('text-primary');
                btn.querySelector('.material-symbols-outlined').classList.remove('text-on-surface');
            });
        });
    </script>
