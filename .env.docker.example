# 复制此文件为 .env 并填写你的配置
# 仅用于 docker-compose.yml，后端无需额外 .env 文件

# ── 数据库 ──
DB_PASSWORD=postgres

# ── JWT ──
JWT_SECRET=换一个随机字符串
JWT_ALGORITHM=HS256

# ── AI 模型（至少配置一个） ──
NUWAX_API_KEY=
NUWAX_AGENT_ID=
DEEPSEEK_API_KEY=

# ── 邮件（QQ邮箱） ──
SMTP_HOST=smtp.qq.com
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的QQ邮箱SMTP授权码
SMTP_FROM_EMAIL=你的QQ邮箱@qq.com

# ── 支付FM（可选） ──
ZHIFUFM_API_URL=
ZHIFUFM_MERCHANT_NUM=
ZHIFUFM_SECRET=
ZHIFUFM_NOTIFY_URL=
ADMIN_SECRET=换一个管理员密钥
